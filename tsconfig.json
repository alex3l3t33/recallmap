{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,

    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2018",
    "lib": ["DOM", "ES2018"],

    "allowJs": false,
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "importHelpers": true,
    "downlevelIteration": true,
    "esModuleInterop": true,

    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
