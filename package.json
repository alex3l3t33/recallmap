{
  "name": "recallmap",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test:model-build": "esbuild src/model.ts --bundle --platform=node --format=esm --outfile=tests/model.bundle.mjs",
    "test": "npm run test:model-build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
